@* @page
@model Proyectamos.Pages.Register.ForgotPasswordModel
@{
    ViewData["Title"] = "Recuperar Contraseña";

    if (HttpContext.Session.GetInt32("UserId") != null)
    {
        HttpContext.Session.Clear();

    }
}

<link rel="stylesheet" href="~/css/LoginRegister.css" />

<div class="login-container">
    <div class="login-left">
        <div class="logo">
            <img src="/images/logo.jpeg" style="width:200px" alt="Logo" />
        </div>
        <h2>¿Olvidaste tu contraseña?</h2>
        <p>No te preocupes, ingresa tu correo electrónico y te ayudaremos a restablecerla.</p>
    </div>

    <div class="login-right">
        <button class="close-btn" onclick="window.location.href='/'">✕</button>

        <h2>Recuperar Contraseña</h2>
        <form method="post">
            <input type="email" asp-for="Email" placeholder="Correo electrónico" required />
            <span asp-validation-for="Email" class="text-danger"></span>

            <button type="submit" class="btn-login">Enviar</button>
        </form>

        @if (Model.Message != null)
        {
            <p class="text-success mt-3">@Html.Raw(Model.Message)</p>
        }


        <p class="register-link">¿Recordaste tu contraseña? <a href="/Register/LoginRegister">Inicia sesión</a></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

 *@