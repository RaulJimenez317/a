@using Proyectamos.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext _context
@{
    var userId = Context.Session.GetInt32("UserId");
    var notifications = new List<Proyectamos.Models.Notification>();

    if (userId != null)
    {
        notifications = _context.Notifications
            .Include(n => n.Project)
            .Include(n => n.FromUser)
            .Where(n => n.UserID == userId && !n.IsRead)
            .OrderByDescending(n => n.Date)
            .ToList();
    }
}

<link rel="stylesheet" href="~/css/notifications.css">

<div class="notification-container position-relative me-3">
    <button class="btn btn-light position-relative" id="notificationButton">
        <i class="bi bi-bell fs-5"></i>
        @if (notifications.Count > 0)
        {
            <span class="badge bg-danger position-absolute top-0 start-100 translate-middle">
                @notifications.Count
            </span>
        }
    </button>

    <div id="notificationList" class="notification-dropdown shadow p-2"
         style="display:none;">
        @if (notifications.Any())
        {
            @foreach (var n in notifications)
            {
                <div class="notification-item p-2 mb-2 rounded shadow-sm">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <strong>@n.Type:</strong> @n.Message
                            <div class="text-muted small">@n.Date.ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                    </div>

                    @if (n.Type == "Solicitud de unión" && n.FromUser != null)
                    {
                        <a class="btn btn-sm btn-primary mt-2 w-100" href="/Profiles/@n.UserID">
                            Ver notificacion
                        </a>
                    }
                    else if (n.Type == "Solicitud aceptada" && n.Project != null)
                    {
                        <a class="btn btn-sm btn-success mt-2 w-100" href="/Projects/Project?id=@n.ProjectID">
                            Ver proyecto
                        </a>
                    }
                    else if (n.Type == "Solicitud rechazada")
                    {
                        <span class="text-muted small mt-2 d-block text-center">Solicitud rechazada</span>
                    }
                </div>
            }
        }
        else
        {
            <div class="text-center text-muted small p-3">
                Sin notificaciones nuevas 🎉
            </div>
        }
    </div>
</div>



<script>
    document.getElementById("notificationButton")?.addEventListener("click", function () {
        const list = document.getElementById("notificationList");
        list.style.display = list.style.display === "none" ? "block" : "none";
    });

    document.addEventListener("click", function(e) {
        const container = document.querySelector(".notification-container");
        const list = document.getElementById("notificationList");
        if (!container.contains(e.target)) {
            list.style.display = "none";
        }
    });
</script>