@{
    int? userIdSession = Context.Session.GetInt32("UserId");

    string? role = Context.Session.GetString("UserRole");
    string homeUrl = "/UserHome/Index";

    if (role == "admin")
    {
        homeUrl = "/AdminHome/Index";
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Proyectamos</title>

    <link rel="stylesheet" href="~/css/index.css" />

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Proyectamos.styles.css" asp-append-version="true" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    @RenderSection("Styles", required: false)
</head>
<body>
    <!-- HEADER -->
    <header class="navbar navbar-expand-lg navbar-light custom-header">
        <div class="container-fluid">

            <!-- Logo-->
            <a class="navbar-brand fw-bold text-dark d-flex align-items-center" href="/">
                <img src="/images/logo.jpeg" alt="Logo" width="60" height="60" class="me-2">
                Proyectamos
            </a>


            <!-- Boton -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                    aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Menu -->
            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0 me-3">
                    @if (userIdSession != null)
                    {
                        <li class="nav-item dropdown me-3">
                            <a class="nav-link dropdown-toggle btn btn-light px-3 py-1 rounded-3 shadow-sm"
                               href="#" id="proyectosDropdown" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-folder2-open me-1"></i> Proyectos
                            </a>
                            <ul class="dropdown-menu shadow-lg rounded-3 p-2" aria-labelledby="proyectosDropdown">
                                <li>
                                    <a class="dropdown-item d-flex align-items-center" href="@homeUrl">
                                        <i class="bi bi-house me-2"></i> Menu Principal
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center" href="/Profiles/@userIdSession">
                                        <i class="bi bi-person-check me-2"></i> Mis proyectos
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item d-flex align-items-center" href="/Projects/LookForProject">
                                        <i class="bi bi-search me-2"></i> Buscar proyectos
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link" href="/Ayuda">Ayuda</a>
                    </li>
                </ul>

                <!-- Iconos -->
                <div class="d-flex align-items-center">

                    @if (userIdSession != null)
                    {
                        <partial name="_NotificationsPartial" />
                    }

                    <div class="dropdown me-3">
                        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="perfilDropdown"
                           role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle fs-5"></i>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-lg rounded-3 p-2" aria-labelledby="perfilDropdown">
                            @if (userIdSession != null)
                            {
                                <li>
                                    <a class="dropdown-item d-flex align-items-center" href="/Profiles/@userIdSession">
                                        <i class="bi bi-person me-2"></i> Mi Perfil
                                    </a>
                                </li>
                            }
                            <li>
                                <a class="dropdown-item d-flex align-items-center" href="/Register/Register">
                                    <i class="bi bi-pencil-square me-2"></i> Registrarse
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center" href="/Register/LoginRegister">
                                    <i class="bi bi-box-arrow-in-right me-2"></i> Iniciar Sesión
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            @if (userIdSession != null)
                            {
                                <li>
                                    <a class="dropdown-item d-flex align-items-center text-danger" href="/Register/LoginRegister">
                                        <i class="bi bi-box-arrow-right me-2"></i> Cerrar sesión
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </header>


    <!-- CONTENIDO -->
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- FOOTER -->
    <footer class="custom-footer mt-5">
        <div class="container d-flex justify-content-between align-items-center flex-wrap flex-column flex-md-row text-center text-md-start">
            <div class="footer-left">
                <p><strong>Contacto</strong></p>
                <p>Desarrollado por UMA</p>
                <p>umaunivalle.com</p>
                <p>Dirección: Tiquipaya-Universidad, Cbba - Bolivia</p>
            </div>

            <div class="footer-center my-3 my-md-0">
                <p>© 2025 Creación de Proyectos. Todos los derechos reservados.</p>
            </div>

            <div class="footer-right">
                <p><strong>Síguenos</strong></p>
                <a href="#"><i class="bi bi-facebook fs-5 me-2"></i></a>
                <a href="#"><i class="bi bi-twitter fs-5 me-2"></i></a>
                <a href="#"><i class="bi bi-instagram fs-5 me-2"></i></a>
                <a href="#"><i class="bi bi-linkedin fs-5"></i></a>
            </div>
        </div>
    </footer>

    <!-- SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
